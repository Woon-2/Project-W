    SetTimer(hwnd_, TIMER_ID, TIMER_MS, nullptr);

    return true;
}



void Application::run() {
    MSG msg;
    while (GetMessageA(&msg, nullptr, 0, 0) > 0) {
        TranslateMessage(&msg);
        DispatchMessageA(&msg);
    }
}



void Application::stepOneTick(HWND hwnd) {
    
    if (controlledPlayer_ && controlledPlayer_->isAlive())
    {
        sim::Vec3 dir{};
        if (keysHeld_[0]) dir.z -= 1.f;   
        if (keysHeld_[1]) dir.z += 1.f;   
        if (keysHeld_[2]) dir.x -= 1.f;   
        if (keysHeld_[3]) dir.x += 1.f;   

        sim::Vec3 pos = controlledPlayer_->getPosition();
        if (dir.lengthSq() > 0.5f)
            controlledPlayer_->setMoveTarget(pos + dir.normalized() * 100.f);
        else
            controlledPlayer_->setMoveTarget(pos);
    }

    room_.tick(DT);
    snapshot_        = room_.buildSnapshot();
    snapshot_.paused = paused_;
    InvalidateRect(hwnd, nullptr, 0);
}



LRESULT __stdcall Application::WndProc(HWND hwnd, UINT msg,
                                        WPARAM wParam, LPARAM lParam) {
    if (msg == 0x0081) {
        
        auto* cs  = reinterpret_cast<CREATESTRUCT*>(lParam);
        auto* app = static_cast<Application*>(cs->lpCreateParams);
        SetWindowLongPtrA(hwnd, (-21), reinterpret_cast<LONG_PTR>(app));
        app->hwnd_ = hwnd;
        return DefWindowProcA(hwnd, msg, wParam, lParam);
    }

    auto* app = reinterpret_cast<Application*>(
        GetWindowLongPtrA(hwnd, (-21)));

    if (app) return app->handleMessage(hwnd, msg, wParam, lParam);
    return DefWindowProcA(hwnd, msg, wParam, lParam);
}



LRESULT Application::handleMessage(HWND hwnd, UINT msg,
                                     WPARAM wParam, LPARAM lParam) {
    switch (msg) {

    
    case 0x0113:
        if (wParam == TIMER_ID && !paused_) {
            stepOneTick(hwnd);
        }
        return 0;

    
    case 0x000F: {
        PAINTSTRUCT ps;
        HDC hdc = BeginPaint(hwnd, &ps);

        RECT cr;
        GetClientRect(hwnd, &cr);
        int cw = cr.right;
        int ch = cr.bottom;

        HDC     memDC = CreateCompatibleDC(hdc);
        HBITMAP memBM = CreateCompatibleBitmap(hdc, cw, ch);
        HBITMAP oldBM = static_cast<HBITMAP>(SelectObject(memDC, memBM));

        renderer_.render(memDC, cw, ch, snapshot_);

        BitBlt(hdc, 0, 0, cw, ch, memDC, 0, 0, (DWORD)0x00CC0020);

        SelectObject(memDC, oldBM);
        DeleteObject(memBM);
        DeleteDC(memDC);

        EndPaint(hwnd, &ps);
        return 0;
    }

    
    case 0x0100:
        if (wParam == 0x20) {
            paused_ = !paused_;
            snapshot_.paused = paused_;
            InvalidateRect(hwnd, nullptr, 0);
            printf("[App] %s\n", paused_ ? "PAUSED" : "RESUMED");
        }
        else if (wParam == 'S' && paused_) {
            stepOneTick(hwnd);
            printf("[App] Step -> tick %llu\n",
                static_cast<unsigned long long>(snapshot_.tick));
        }
        else if (wParam == 0x1B) {
            PostQuitMessage(0);
        }
        else if (wParam == 0x26)    { keysHeld_[0] = true; }
        else if (wParam == 0x28)  { keysHeld_[1] = true; }
        else if (wParam == 0x25)  { keysHeld_[2] = true; }
        else if (wParam == 0x27) { keysHeld_[3] = true; }
        return 0;

    case 0x0101:
        if      (wParam == 0x26)    { keysHeld_[0] = false; }
        else if (wParam == 0x28)  { keysHeld_[1] = false; }
        else if (wParam == 0x25)  { keysHeld_[2] = false; }
        else if (wParam == 0x27) { keysHeld_[3] = false; }
        return 0;

    
    case 0x0014:
        return 1;

    
    case 0x0002:
        KillTimer(hwnd, TIMER_ID);
        PostQuitMessage(0);
        return 0;

    default:
        return DefWindowProcA(hwnd, msg, wParam, lParam);
    }
}

