bool Application::init(HINSTANCE hInst, int nCmdShow) {
    hInst_ = hInst;

    
    WNDCLASSEXA wc    = {};
    wc.cbSize         = sizeof(wc);
    wc.style          = 0x0002 | 0x0001;
    wc.lpfnWndProc    = WndProc;
    wc.hInstance      = hInst;
    wc.hCursor        = LoadCursorA(nullptr, ((LPSTR)((ULONG_PTR)((WORD)(32512)))));
    wc.hbrBackground  = nullptr;          
    wc.lpszClassName  = "NPCAISimViz";
    wc.hIcon          = LoadIconA(nullptr, ((LPSTR)((ULONG_PTR)((WORD)(32512)))));

    if (!RegisterClassExA(&wc)) {
        MessageBoxA(nullptr, "RegisterClassEx failed", "Error", 0x00000000L);
        return false;
    }

    
    RECT rc = { 0, 0, CLIENT_W, CLIENT_H };
    AdjustWindowRect(&rc, (0x00000000L | 0x00C00000L | 0x00080000L | 0x00040000L | 0x00020000L | 0x00010000L), 0);

    hwnd_ = CreateWindowExA(
        0,
        "NPCAISimViz",
        "NPC AI Simulator  |  Arrows = Move   Space = Pause/Resume   S = Step   Esc = Quit",
        (0x00000000L | 0x00C00000L | 0x00080000L | 0x00040000L | 0x00020000L | 0x00010000L),
        ((int)0x80000000), ((int)0x80000000),
        rc.right - rc.left, rc.bottom - rc.top,
        nullptr, nullptr, hInst, this);   

    if (!hwnd_) {
        MessageBoxA(nullptr, "CreateWindowEx failed", "Error", 0x00000000L);
        return false;
    }

    scenario_ = std::make_unique<sim::ScenarioSoloNpc>();
